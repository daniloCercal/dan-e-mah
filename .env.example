# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o git.
# Variáveis com NEXT_PUBLIC_ aparecem no navegador; as outras ficam só no servidor.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor. Nunca colar em chat nem em código do navegador.
SUPABASE_SECRET_KEY=

# --- Quem pode entrar (os dois e-mails do Google, separados por vírgula) ---
ALLOWED_EMAILS=

# --- IGDB, catálogo de jogos (dev.twitch.tv → Applications) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Steam (opcional, só depois do MVP: steamcommunity.com/dev/apikey) ---
STEAM_WEB_API_KEY=

# As credenciais do Google OAuth (Client ID e Client Secret) NÃO entram aqui:
# elas são coladas no painel do Supabase, em Authentication → Providers → Google.
